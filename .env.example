# ──────────────────────────────────────────────────────────────
# 환경 변수 템플릿
#
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채워 넣어라:
#   cp .env.example .env.local
#
# .env.local 은 .gitignore 되어 커밋되지 않는다. 실제 키는 절대 커밋하지 마라.
# 값은 Supabase 대시보드 → Project Settings → API 에서 확인한다.
# ──────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL (예: https://abcdefgh.supabase.co)
# 브라우저에 노출되는 공개값이다.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(public) 키.
# 브라우저에 노출되는 공개값이며, 보호는 전적으로 RLS 정책에 의존한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role 키 — RLS를 우회하는 관리자 키.
# CRITICAL: 서버 코드에서만 읽는다. NEXT_PUBLIC_ 접두사를 붙이지 마라.
# 유출되면 DB 전체가 열린다.
SUPABASE_SERVICE_ROLE_KEY=
